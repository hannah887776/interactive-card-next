# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# Ignore generated files in the nested project folder
/interactive-card-next/node_modules/
/interactive-card-next/.next/
/interactive-card-next/out/
/interactive-card-next/build/
/interactive-card-next/.env*
